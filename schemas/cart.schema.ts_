import { Prop, Schema, SchemaFactory } from '@nestjs/mongoose';
import { HydratedDocument, Types } from 'mongoose';
import { CartItemSchema } from './cart-item.schema';

export type CartDocument = HydratedDocument<Cart>;

@Schema({ timestamps: true, collection: 'carts' })
export class Cart {
  @Prop({ type: Types.ObjectId, ref: 'User', required: true, unique: true })
  userId: Types.ObjectId;

  @Prop({ type: [CartItemSchema], default: [] })
  items: CartItemSchema[];

  @Prop({ default: 0, min: 0 })
  totalItems: number; // Count of items

  @Prop({ default: 0, min: 0 })
  totalQuantity: number; // Sum of quantities

  @Prop({ default: 0, min: 0 })
  subtotal: number; // Sum of (quantity * price)

  @Prop({ default: 0, min: 0 })
  totalDiscount: number; // Sum of discounts

  @Prop({ default: 0, min: 0 })
  totalPrice: number; // subtotal - totalDiscount

  @Prop({ type: String, enum: ['active', 'abandoned', 'converted'], default: 'active' })
  status: string;

  @Prop({ type: Date, default: null })
  abandonedAt: Date;

  @Prop({ type: Date, default: null })
  convertedAt: Date;

  @Prop({ default: true })
  isActive: boolean;
}

export const CartSchema = SchemaFactory.createForClass(Cart);

CartSchema.index({ userId: 1 });
CartSchema.index({ status: 1 });
CartSchema.index({ createdAt: -1 });
CartSchema.index({ 'items.productId': 1 });